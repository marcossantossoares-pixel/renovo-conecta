# =============================================================================
# Renovo Conecta — exemplo de variáveis de ambiente
# =============================================================================
#
# Copie este arquivo para .env.local e preencha com os valores do SEU ambiente.
#
#   cp .env.example .env.local
#
# REGRAS:
#   - Este arquivo é versionado e NUNCA contém segredo real.
#   - .env e .env.local estão no .gitignore. Não os versione.
#   - Variáveis com prefixo NEXT_PUBLIC_ VÃO PARA O NAVEGADOR.
#     Nada sensível recebe esse prefixo.
#   - As variáveis são validadas com Zod na inicialização. Faltando ou
#     malformada, a aplicação não sobe.
#   - Em produção e homologação, os valores ficam nas configurações da
#     Vercel e do Supabase — nunca em arquivo.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------

# NODE_ENV NÃO deve ser definida aqui.
#
# O Next.js a define sozinho conforme o comando (dev, build, start). Fixá-la
# no arquivo faz o valor vazar para o build — e um `next build` rodando com
# NODE_ENV=development falha ao gerar as páginas.

# URL pública da aplicação (sem barra no final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Fuso horário da igreja
APP_TIMEZONE=America/Bahia

# Referência visual dos componentes, em /design-system.
# Ferramenta interna: deixe habilitada em desenvolvimento e homologação, e
# defina "false" em PRODUÇÃO — a rota passa a responder 404.
DESIGN_SYSTEM_ENABLED=true


# -----------------------------------------------------------------------------
# Supabase — conexão do cliente (público)
# -----------------------------------------------------------------------------
# A chave anon é pública por natureza. A proteção real vem da Row Level
# Security, não do sigilo desta chave.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Supabase — servidor (SECRETO)
# -----------------------------------------------------------------------------
# ATENÇÃO: SUPABASE_SERVICE_ROLE_KEY ignora TODA a Row Level Security.
#
#   - Existe apenas no servidor. NUNCA no cliente.
#   - Uso restrito a src/core/db/admin.ts (ver docs/SECURITY.md §4).
#   - Jamais adicione o prefixo NEXT_PUBLIC_ a esta variável.
#   - Em caso de suspeita de exposição, rotacione imediatamente.

SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Banco de dados (Drizzle)
# -----------------------------------------------------------------------------
# Conexão da APLICAÇÃO.
#
# Use o papel `authenticator`, NUNCA `postgres`.
#
# `authenticator` não é superusuário, não ignora RLS e não tem privilégio
# sobre nenhuma tabela. Ele existe apenas para assumir um papel dentro da
# transação:
#   - `authenticated`  → caminho normal, sujeito à Row Level Security;
#   - `service_role`   → caminho pré-autenticação (rate limiting, auditoria
#                        de login), com acesso restrito ao mínimo.
#
# Consequência prática: uma consulta escrita sem contexto por engano falha com
# "permission denied" em vez de rodar como superusuário em silêncio.
DATABASE_URL=postgresql://authenticator:postgres@127.0.0.1:54322/postgres

# Conexão de MIGRATIONS e SEEDS — privilégio total.
# Nunca use esta URL na aplicação.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres


# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------

# Validade do convite, em dias
AUTH_INVITATION_EXPIRY_DAYS=7

# Validade do link de recuperação de senha, em minutos
AUTH_PASSWORD_RESET_EXPIRY_MINUTES=60

# Exigir segundo fator para papéis administrativos
AUTH_REQUIRE_MFA_FOR_ADMIN=true


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3
RATE_LIMIT_EXPORT_PER_HOUR=5


# -----------------------------------------------------------------------------
# Arquivos
# -----------------------------------------------------------------------------
# O bucket é PRIVADO. O acesso se dá por URL assinada de curta duração.

STORAGE_BUCKET=renovo-conecta
STORAGE_SIGNED_URL_TTL_SECONDS=900
STORAGE_MAX_FILE_SIZE_MB=10


# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
# Deixe em branco para desabilitar em ambiente local.
# O scrubbing de dados pessoais é obrigatório (docs/SECURITY.md §9).

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# debug | info | warn | error
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Seeds de demonstração (apenas local e homologação)
# -----------------------------------------------------------------------------
# Senha das contas fictícias de demonstração.
# Deixe SEM valor aqui. Defina apenas no seu .env.local.
# O seed se recusa a rodar contra o banco de produção.

SEED_DEMO_PASSWORD=


# -----------------------------------------------------------------------------
# NÃO CONFIGURE AINDA — fases futuras
# -----------------------------------------------------------------------------
# As integrações abaixo pertencem às Prioridades 2 e 3. Estão listadas apenas
# para documentar o formato esperado. Nenhuma delas é lida pelo código do MVP.
#
# WHATSAPP_BUSINESS_TOKEN=
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PAYMENT_PROVIDER_API_KEY=
